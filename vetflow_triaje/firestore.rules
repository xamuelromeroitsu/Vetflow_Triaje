rules_version = '2';

// Firebase Firestore Rules for Vetflow Triaje
// Modo Firebase Auth nativo (email/contraseña).
// El role se lee de la colección users/{uid} (campo `role`).
//
// Colecciones principales:
//   - users/{uid}: perfil y rol del usuario autenticado
//   - owners/{ownerId}: dueños de mascotas (ownerId == auth.uid en MVP)
//   - pets/{petId}: mascotas (referencia a owners/{ownerId})
//   - visits/{visitId}: visitas/triage clínica y cola

service cloud.firestore {

  // --- FUNCIONES AUXILIARES ---

  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(String ownerId) {
    return request.auth.uid == ownerId;
  }

  function isPersonal() {
    return request.auth.token.role == 'personal';
  }

  // Valida que un documento de visita tenga los campos obligatorios
  function visitHasRequiredFields() {
    return request.resource.data.petId is string &&
      request.resource.data.petId.size() > 0;
  }

  // Valida que el nivel de triaje sea uno de los permitidos
  function validTriageLevel(String level) {
    return level == 'consulta' || level == 'urgencia' || level == 'emergencia';
  }

  // Valida que el estado de cola sea uno de los permitidos
  function validQueueStatus(String status) {
    return status == 'pendiente' ||
      status == 'en_atencion' ||
      status == 'atendido' ||
      status == 'cancelado';
  }

  // --- USUARIO (users/{uid}) ---

  match /users/{uid} {
    allow read: if isSignedIn();
    allow create: if isSignedIn();
    allow update: if isOwner(uid);
    allow delete: if false;
  }

  // --- PROPIETARIOS (owners/{ownerId}) ---

  match /owners/{ownerId} {
    allow read: if isSignedIn();
    allow create: if isSignedIn() && isOwner(ownerId);
    allow update: if isOwner(ownerId);
    allow delete: if false;
  }

  // --- MASCOTAS (pets/{petId}) ---

  match /pets/{petId} {
    allow read: if isSignedIn();
    allow create: if isSignedIn() &&
      isOwner(request.resource.data.ownerId);
    allow update: if isOwner(request.resource.data.ownerId);
    allow delete: if false;
  }

  // --- VISITAS (visits/{visitId}) ---
  // Incluye triaje (suggested/confirmed/reasons/rulesVersion) y cola
  // (status, assignedRoom, assignedVeterinarian, position).

  match /visits/{visitId} {
    allow read: if isSignedIn();
    allow create: if isSignedIn() && visitHasRequiredFields();
    allow update: if
      isOwner(
        get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.ownerId
      ) ||
      isPersonal();
    allow delete: if false;
  }

  // --- COLECTORA: todas las demás colecciones ---
  // Denegar por defecto para colecciones no explícitamente definidas
  match /{document=**} {
    allow read: if false;
    allow write: if false;
  }
}
