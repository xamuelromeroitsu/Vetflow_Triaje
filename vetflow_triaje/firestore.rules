rules_version = '2';

// Firebase Firestore Rules for Vetflow Triaje
// Modo Firebase Auth nativo (email/contraseña).
// El role se lee de la colección users/{uid} (campo `role`).
//
// Colecciones principales:
//   - users/{uid}: perfil y rol del usuario autenticado
//   - owners/{ownerId}: dueños de mascotas (ownerId == auth.uid en MVP)
//   - pets/{petId}: mascotas (referencia a owners/{ownerId})
//   - visits/{visitId}: visitas/triage clínica y cola
//   - clinics/{clinicId}: directorio de clínicas veterinarias
//   - appointments/{appointmentId}: citas programadas
//   - health_records/{recordId}: carnet de salud de la mascota
//   - pet_vaccines/{vaccineId}: vacunas de la mascota
//   - pet_treatments/{treatmentId}: tratamientos de la mascota

service cloud.firestore {

  // --- FUNCIONES AUXILIARES ---

  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(String ownerId) {
    return request.auth.uid == ownerId;
  }

  /// Lee el rol del usuario desde su perfil en users/{uid}.
  function userRole() {
    return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
  }

  function isPersonal() {
    return isSignedIn() && userRole() == 'personal';
  }

  // Valida que un documento de visita tenga los campos obligatorios
  function visitHasRequiredFields() {
    return request.resource.data.petId is string &&
      request.resource.data.petId.size() > 0;
  }

  // Valida que el nivel de triaje sea uno de los permitidos
  function validTriageLevel(String level) {
    return level == 'consulta' || level == 'urgencia' || level == 'emergencia';
  }

  // Valida que el estado de cola sea uno de los permitidos
  function validQueueStatus(String status) {
    return status == 'pendiente' ||
      status == 'en_atencion' ||
      status == 'atendido' ||
      status == 'cancelado';
  }

  // Valida que el estado de cita sea uno de los permitidos
  function validAppointmentStatus(String status) {
    return status == 'programada' ||
      status == 'confirmada' ||
      status == 'en_curso' ||
      status == 'completada' ||
      status == 'cancelada' ||
      status == 'reprogramada';
  }

  // Devuelve el ownerId de una mascota dada su petId
  function petOwnerId(String petId) {
    return get(/databases/$(database)/documents/pets/$(petId)).data.ownerId;
  }

  // Verifica si el usuario es dueño de la mascota dada por petId
  function isPetOwner(String petId) {
    return isSignedIn() && isOwner(petOwnerId(petId));
  }

  // --- USUARIO (users/{uid}) ---

  match /users/{uid} {
    allow read: if isSignedIn();
    allow create: if isSignedIn();
    allow update: if isOwner(uid);
    allow delete: if false;
  }

  // --- PROPIETARIOS (owners/{ownerId}) ---

  match /owners/{ownerId} {
    allow read: if isSignedIn();
    allow create: if isSignedIn() && isOwner(ownerId);
    allow update: if isOwner(ownerId);
    allow delete: if false;
  }

  // --- MASCOTAS (pets/{petId}) ---

  match /pets/{petId} {
    allow read: if isSignedIn();
    allow create: if isSignedIn() &&
      isOwner(request.resource.data.ownerId);
    allow update: if isOwner(request.resource.data.ownerId);
    allow delete: if false;
  }

  // --- VISITAS (visits/{visitId}) ---
  // Incluye triaje (suggested/confirmed/reasons/rulesVersion) y cola
  // (status, assignedRoom, assignedVeterinarian, position).

  match /visits/{visitId} {
    allow read: if isSignedIn();
    allow create: if isSignedIn() && visitHasRequiredFields();
    allow update: if
      isOwner(
        get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.ownerId
      ) ||
      isPersonal();
    allow delete: if false;
  }

  // --- CLÍNICAS (clinics/{clinicId}) ---
  // Directorio legible por cualquier usuario autenticado;
  // escritura solo para personal.

  match /clinics/{clinicId} {
    allow read: if isSignedIn();
    allow create: if isSignedIn() && isPersonal();
    allow update: if isPersonal();
    allow delete: if false;
  }

  // --- CITAS (appointments/{appointmentId}) ---
  // Solo el dueño de la mascota o personal pueden leer/escribir.
  // El nivel de triaje debe ser "consulta".

  match /appointments/{appointmentId} {
    allow read: if isSignedIn() &&
      (isOwner(request.resource.data.ownerId) || isPersonal());
    allow create: if isSignedIn() &&
      request.resource.data.triageLevel == 'consulta' &&
      (isOwner(request.resource.data.ownerId) || isPersonal());
    allow update: if isSignedIn() &&
      (isPetOwner(request.resource.data.petId) || isPersonal());
    allow delete: if false;
  }

  // --- CARNET DE SALUD (health_records/{recordId}) ---
  // Vinculado a una mascota. Lectura para dueño y personal;
  // escritura para el dueño (contactos) y personal (historial clínico).

  match /health_records/{recordId} {
    allow read: if isSignedIn() &&
      (isPetOwner(request.resource.data.petId) || isPersonal());
    allow create: if isSignedIn() &&
      isPetOwner(request.resource.data.petId);
    allow update: if isSignedIn() &&
      (isPetOwner(request.resource.data.petId) || isPersonal());
    allow delete: if false;
  }

  // --- VACUNAS (pet_vaccines/{vaccineId}) ---
  match /pet_vaccines/{vaccineId} {
    allow read: if isSignedIn() &&
      (isPetOwner(request.resource.data.petId) || isPersonal());
    allow create: if isSignedIn() &&
      (isPetOwner(request.resource.data.petId) || isPersonal());
    allow update: if isSignedIn() &&
      (isPetOwner(request.resource.data.petId) || isPersonal());
    allow delete: if false;
  }

  // --- TRATAMIENTOS (pet_treatments/{treatmentId}) ---
  match /pet_treatments/{treatmentId} {
    allow read: if isSignedIn() &&
      (isPetOwner(request.resource.data.petId) || isPersonal());
    allow create: if isSignedIn() &&
      (isPetOwner(request.resource.data.petId) || isPersonal());
    allow update: if isSignedIn() &&
      (isPetOwner(request.resource.data.petId) || isPersonal());
    allow delete: if false;
  }

  // --- COLECTORA: todas las demás colecciones ---
  // Denegar por defecto para colecciones no explícitamente definidas
  match /{document=**} {
    allow read: if false;
    allow write: if false;
  }
}
