rules_version = '2';

// Firebase Firestore Rules for Vetflow Triaje
// Adaptadas para funcionar con JWTs personalizados O Firebase Auth nativo.
// El role ('dueno'/'personal') se puede leer de dos formas:
//   1. claims JWT: request.auth.token.role  (modo JWT)
//   2. Colección users/{uid}: documento role field (modo Firebase/nativo)
//
// Este archivo está diseñado para modo híbrido o transición a JWT.
//
// Colecciones principales:
//   - users/{uid}: perfil y rol del usuario autenticado
//   - owners/{ownerId}: dueños de mascotas
//   - pets/{petId}: mascotas
//   - visits/{visitId}: visitas/triage clínica

service cloud.firestore {

  // --- FUNCIONES AUXILIARES ---

  // Verifica si hay usuario autenticado (modo Firebase o JWT con claims)
  function isSignedIn() {
    return request.auth != null;
  }

  // Obtiene el role del usuario desde claims JWT
  // Retorna 'dueno', 'personal' o null si no hay claims
  function getRoleFromJwt() {
    try {
      // En modo JWT, el token debería tener role en claims
      // Si no existe o está vacío, retorna null
      final role = request.auth.token.role;
      if (role != null && (role == 'dueno' || role == 'personal')) {
        return role;
      }
      return null;
    } catch (_) {
      return null;
    }
  }

  // Obtiene el role consultando la colección users/{uid}
  // Esta es la forma nativa de Firebase (antes de JWT)
  function getRoleFromUsersCollection(String uid) {
    // Leer el documento users/{uid} y obtener el campo role
    // Nota: Firestore rules no pueden leer otros documentos directamente
    // en la misma expresión allow. Esta función es conceptual.
    // En la práctica, se usan técnicas como:
    // - Obtener el documento en una función separada
    // - O usar get() dentro de reglas (limitado)
    // - O confiar en claims JWT en su lugar
    return null; // Placeholder: Firestore rules no pueden cross-read fácilmente
  }

  // Verifica si el usuario autenticado es dueño de un recurso específico
  function esPropietarioDe(String ownerId) {
    // Intento 1: Verificar desde claims JWT
    final roleFromJwt = getRoleFromJwt();
    if (roleFromJwt == 'dueno' && request.auth.uid == ownerId) {
      return true;
    }

    // Intento 2: Verificación delegada a la aplicación
    // Firestore rules no pueden hacer queries complejas cross-document
    // La validación real 'ownerId == auth.uid' se hace típicamente:
    // 1. Cuando el usuario se registra: ownerId = auth.uid
    // 2. En la app: validar antes de escribir
    // Aquí retornamos false y dejamos la validación a la capa de aplicación,
    // pero permitimos la lectura basada en role si viene del JWT.
    return false;
  }

  // --- USUARIO (users/{uid}) ---

  // Las reglas permiten lectura si hay usuario autenticado.
  // El role se gestiona vía JWT claims o colección users.
  match /users/{uid} {
    allow read: if isSignedIn();
    // Escritura (creación) solo ocurre durante el registro automático
    // en modo Firebase, o es manejada por el backend en modo JWT
    allow create: if isSignedIn() &&
      // En modo Firebase: auto-registro crea dueno
      (
        // Simplificación: permitir si es nuevo usuario registrándose
        // La validación real del rol (dueno/personal) se hace en el backend
        true
      ) ||
      // En modo JWT: backend emite token con role correcto
      true
    allow update: if isOwnProfile(uid);
    allow delete: if false;
  }

  // --- PROPIETARIOS (owners/{ownerId}) ---

  match /owners/{ownerId} {
    allow read: if isSignedIn();  // Cual usuario logueado puede leer (restringido por app)
    allow create: if isSignedIn() && 
      // Dueño crea su propio perfil de dueño
      ( 
        request.auth.token.role == 'dueno' || 
        // En modo Firebase/transition: uid del dueño es el ownerId
        request.auth.uid == ownerId
      )
    allow update: if esPropietarioDe(ownerId);
    allow delete: if false;
  }

  // --- MASCOTAS (pets/{petId}) ---

  match /pets/{petId} {
    allow read: if isSignedIn();  // Lectura general en clínica (con restricciones UI)
    allow create: if isSignedIn() && 
      // Dueño puede crear su mascota si tiene perfil de dueño asociado
      ( 
        // Modo JWT: role dueno y validación en app
        request.auth.token.role == 'dueno' ||
        // Modo Firebase/transition: uid del dueño coincide
        request.auth.uid == request.resource.data.ownerId
      )
    allow update: if 
      // Dueño o personal pueden actualizar
      (
        esPropietarioDe(/owners/{ownerId}/data.ownerId) ||
        request.auth.token.role == 'personal'
      )
    allow delete: if false;
  }

  // --- VISITAS (visits/{visitId}) ---

  match /visits/{visitId} {
    allow read: if isSignedIn();  // Tanto dueño como personal
    allow create: if isSignedIn() && 
      // Ambos roles pueden crear triaje: dueño o personal
      (
        request.auth.token.role == 'dueno' ||
        request.auth.token.role == 'personal'
      )
    allow update: if 
      (
        // Dueño edita sus visitas (ownerId debe coincidir)
        esPropietarioDe(/owners/{ownerId}/data.ownerId) ||
        // Personal gestiona visitas clínicas
        request.auth.token.role == 'personal'
      )
    allow delete: if false;
  }

  // --- COLECTORA: todas las demás colecciones ---
  // Denegar por defecto para colecciones no explicitly definidas
  match /{document=**} {
    allow read: if isSignedIn();
    allow write: if false;
  }
}